{
  "name": "ccnyc",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "profile:homepage": "node scripts/profile-homepage.mjs",
    "check": "npm run format:check && npm run lint && npm run test:unit && npm run build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "typescript": "^5.7.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
